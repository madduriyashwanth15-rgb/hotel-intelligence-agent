# Copy to .env and fill in local-only values. Never commit .env.
# Everything runs locally; no cloud credentials are needed or used.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (local Docker container) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hotel_agent
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=change-me-local-only

# Read-only login role (used later by Text-to-SQL). Created by migrations.
READONLY_DB_USER=hotel_reader
READONLY_DB_PASSWORD=change-me-readonly-local-only

# Login role that executes generated SQL; it can read analytics views only (Phase 3).
SQL_DB_USER=hotel_sql
SQL_DB_PASSWORD=change-me-sql-local-only

# Login role used by the MCP tool gateway (Phase 4); least privilege, no DELETE/DDL.
OPS_DB_USER=hotel_ops
OPS_DB_PASSWORD=change-me-ops-local-only

# Database used by the test suite (dropped and recreated on every run).
TEST_POSTGRES_DB=hotel_agent_test

# --- Synthetic data generator ---
SYNTHETIC_SEED=42
# Generated data is centred on this date so results are reproducible.
SYNTHETIC_ANCHOR_DATE=2026-10-01

# --- Knowledge base / local embeddings (Phase 2) ---
# Paths are relative to the project root. The model is downloaded once with
# `uv run hotel-kb download-model` (free, anonymous); afterwards it runs offline.
KB_DIR=data/knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.models
# CPU threads for embedding; keep low on small machines.
EMBEDDING_THREADS=2
# Evidence thresholds for answering vs "I don't know" (calibrated; see docs/DECISIONS.md).
KB_MIN_SIMILARITY=0.58
KB_MIN_COVERAGE=0.45

# --- Agent router model (Phase 6, ADR-0025) -------------------------------------------
# "deterministic" (default, no model) or "ollama" (local Ollama server, loopback only).
LLM_PROVIDER=deterministic
# Route requests the model fails on (error / invalid output) with the deterministic router.
LLM_FALLBACK=true
# Must be a loopback http address; anything else is refused (no external providers).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_S=60
OLLAMA_NUM_CTX=4096

# --- HTTP agent endpoint (Phase 7, ADR-0027) ------------------------------------------
# Staff principal POST /agent/ask acts as. NO AUTHENTICATION: anyone who can reach the API
# acts as this staff member. Local development only; comment out to disable the endpoint.
AGENT_STAFF_CODE=S-FD-01
